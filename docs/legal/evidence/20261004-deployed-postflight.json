    "evidence": {
      "cmd": "ALL",
      "qual": "((auth.uid() IS NOT NULL) AND ((EXISTS ( SELECT 1\n   FROM club_members m\n  WHERE ((m.club_id = marketplace_items.club_id) AND (m.user_id = auth.uid()) AND m.is_active))) OR (EXISTS ( SELECT 1\n   FROM (player_guardians g\n     JOIN club_members m ON ((m.user_id = g.player_id)))\n  WHERE ((g.guardian_user_id = auth.uid()) AND (g.player_id = marketplace_items.user_id) AND COALESCE(g.can_view, false) AND (m.club_id = marketplace_items.club_id) AND (m.role = 'player'::club_role) AND m.is_active)))))",
      "roles": [
        "anon",
        "authenticated"
      ],
      "permissive": "RESTRICTIVE",
      "with_check": "((auth.uid() IS NOT NULL) AND ((EXISTS ( SELECT 1\n   FROM club_members m\n  WHERE ((m.club_id = marketplace_items.club_id) AND (m.user_id = auth.uid()) AND m.is_active))) OR (EXISTS ( SELECT 1\n   FROM (player_guardians g\n     JOIN club_members m ON ((m.user_id = g.player_id)))\n  WHERE ((g.guardian_user_id = auth.uid()) AND (g.player_id = marketplace_items.user_id) AND COALESCE(g.can_edit, false) AND (m.club_id = marketplace_items.club_id) AND (m.role = 'player'::club_role) AND m.is_active)))))"
